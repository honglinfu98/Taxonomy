    "dlt_network_access_scope" [label="Ledger scope: open or closed access by design"];
    "governance_model" [label="Governance model of a DLT system"];
    "software_architecture" [label="Software architecture (monolithic vs polylithic)"];
    "code_license_openness" [label="Source code openness"];
    "digital_identity_layer" [label="Identity layer and onboarding"];
    "privacy_enhancement" [label="Privacy and anonymity features"];
    "ledger_storage_model" [label="Ledger storage model (what is stored on chain)"];
